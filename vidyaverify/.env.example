# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=vidyaverify
POSTGRES_USER=vidyaverify_user
POSTGRES_PASSWORD=change_me_in_production

# ─── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vidyaverify_user:change_me_in_production@db:5432/vidyaverify
SECRET_KEY=change_me_32_char_secret_key_here!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Upload limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
